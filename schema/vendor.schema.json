{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/DanB13/cairn/schema/vendor.schema.json",
  "title": "Vendor page frontmatter",
  "description": "Descriptive layer. Holds observed intel only; interpretation lives in the paired assessment file.",
  "type": "object",
  "required": [
    "schema_version", "slug", "name", "tier", "lanes",
    "cadence", "last_reviewed", "data_as_of", "reverify_by", "status"
  ],
  "additionalProperties": false,
  "properties": {
    "schema_version": { "$ref": "common.schema.json#/$defs/schema_version" },
    "slug": { "$ref": "common.schema.json#/$defs/slug" },
    "name": { "type": "string", "minLength": 1 },
    "aliases": { "type": "array", "items": { "type": "string" } },
    "tier": {
      "type": "string",
      "description": "Must exist in the active profile's tier vocabulary. tiers.yaml is the source of truth."
    },
    "lanes": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string" },
      "description": "Profile-extensible vocabulary. Deliberately open in schema, closed by the active profile."
    },
    "flags": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "dual_role": {
          "type": "boolean",
          "description": "Both competitor and integration partner. Structural in platform-adjacent markets."
        },
        "convergence": {
          "type": "boolean",
          "description": "Competes across two or more lanes; surfaced under each, not only its home lane."
        },
        "platform_native": {
          "type": "boolean",
          "description": "Capability bundled into a platform the buyer already owns."
        },
        "status_quo": {
          "type": "boolean",
          "description": "Represents do-nothing / existing tooling rather than a vendor."
        }
      }
    },
    "parent_vendor": {
      "oneOf": [{ "$ref": "common.schema.json#/$defs/slug" }, { "type": "null" }]
    },
    "cadence": { "$ref": "common.schema.json#/$defs/cadence" },
    "last_reviewed": { "$ref": "common.schema.json#/$defs/date" },
    "data_as_of": { "$ref": "common.schema.json#/$defs/date" },
    "reverify_by": { "$ref": "common.schema.json#/$defs/date" },
    "owner": { "$ref": "common.schema.json#/$defs/contributor" },
    "status": { "$ref": "common.schema.json#/$defs/status" },
    "merged_into": {
      "oneOf": [{ "$ref": "common.schema.json#/$defs/slug" }, { "type": "null" }]
    }
  }
}
